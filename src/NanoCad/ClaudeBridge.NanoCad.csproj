<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ClaudeBridge.NanoCad</RootNamespace>
    <AssemblyName>ClaudeBridge.NanoCad</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NanoCadRoot Condition="'$(NanoCadRoot)' == ''">C:\Program Files\Nanosoft\nanoCAD x64 24.1</NanoCadRoot>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Snapshot rendering uses System.Drawing.Bitmap (returned by Teigha GsView.GetSnapshot).
      hostmgd pulls this in transitively, but the compiler still requires an explicit reference
      for direct use in our code.
    -->
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="hostmgd">
      <HintPath>$(NanoCadRoot)\bin\hostmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="hostdbmgd">
      <HintPath>$(NanoCadRoot)\bin\hostdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="nrxgatemgd">
      <HintPath>$(NanoCadRoot)\bin\nrxgatemgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
