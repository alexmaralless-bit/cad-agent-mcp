{
  "name": "mcp-nano-bridge",
  "version": "0.5.0",
  "description": "MCP server bridging Claude to the ClaudeBridge.NanoCad HTTP listener on 127.0.0.1:7890",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-nano-bridge": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
